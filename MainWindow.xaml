<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Tetris — OpenGL Neon Edition"
        Height="640" Width="820"
        MinWidth="640" MinHeight="620"
        Foreground="#E6F7FF"
        FontFamily="Segoe UI" FontSize="22"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
  <Grid>
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#121629" Offset="0.0"/>
        <GradientStop Color="#07080F" Offset="1.0"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Pontszám kijelző -->
    <Border Grid.Row="0" Grid.Column="1"
            Background="#0D111E"
            BorderBrush="#1F3A52"
            BorderThickness="1.5"
            CornerRadius="6"
            Padding="24,8"
            Margin="0,16,0,12"
            HorizontalAlignment="Center">
      <TextBlock x:Name="ScoreText"
                 Text="SCORE  0"
                 FontWeight="SemiBold"
                 Foreground="#00F0FF"
                 TextAlignment="Center"/>
    </Border>

    <!-- Központi OpenGL játéktér -->
    <Border Grid.Row="1" Grid.Column="1"
            BorderBrush="#00F0FF"
            BorderThickness="2"
            CornerRadius="2"
            Margin="0,0,0,24"
            Width="254"
            Height="504">
      <Border.Effect>
        <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
      </Border.Effect>
      <glWpfControl:GLWpfControl x:Name="OpenGLControl"
                                 Ready="OpenGLControl_Ready"
                                 Render="OpenGLControl_Render"/>
    </Border>

    <!-- Bal panel: Hold -->
    <StackPanel Grid.Row="1" Grid.Column="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0,0,36,0">
      <TextBlock Text="HOLD"
                 FontSize="16"
                 FontWeight="Bold"
                 Foreground="#7A8BA8"
                 TextAlignment="Center"
                 Margin="0,0,0,8"/>
      <Border Background="#0A0D18"
              BorderBrush="#1F3A52"
              BorderThickness="1.5"
              CornerRadius="8"
              Padding="14">
        <Image x:Name="HoldImage"
               Width="100"
               Height="100"/>
      </Border>
    </StackPanel>

    <!-- Jobb panel: Next -->
    <StackPanel Grid.Row="1" Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="36,0,0,0">
      <TextBlock Text="NEXT"
                 FontSize="16"
                 FontWeight="Bold"
                 Foreground="#7A8BA8"
                 TextAlignment="Center"
                 Margin="0,0,0,8"/>
      <Border Background="#0A0D18"
              BorderBrush="#1F3A52"
              BorderThickness="1.5"
              CornerRadius="8"
              Padding="14">
        <Image x:Name="NextImage"
               Width="100"
               Height="100"/>
      </Border>
    </StackPanel>

    <!-- Game Over Overlay -->
    <Grid x:Name="GameOverMenu"
          Background="#D905070D"
          Grid.RowSpan="2"
          Grid.ColumnSpan="3"
          Visibility="Hidden">
      <Border Background="#0E1324"
              BorderBrush="#00F0FF"
              BorderThickness="2"
              CornerRadius="10"
              Padding="44,32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="GAME OVER"
                     FontSize="42"
                     FontWeight="Bold"
                     Foreground="#FF2A55"
                     TextAlignment="Center"/>
          <TextBlock x:Name="FinalScoreText"
                     Text="SCORE  0"
                     FontSize="26"
                     Foreground="#E6F7FF"
                     Margin="0,12,0,24"
                     TextAlignment="Center"/>
          <Button Content="PLAY AGAIN"
                  FontSize="18"
                  FontWeight="Bold"
                  Background="#00F0FF"
                  Foreground="#050811"
                  BorderThickness="0"
                  Padding="28,12"
                  Cursor="Hand"
                  Click="PlayAgain_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>